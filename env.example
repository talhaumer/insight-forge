# Insight Forge Environment Variables
# Copy this file to .env and fill in your actual API keys

# Required API Keys
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: LangSmith for enhanced observability
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=insight-forge

# Optional: Application settings
LOG_LEVEL=INFO
DEBUG=false

# Optional: Server settings (for production)
HOST=0.0.0.0
PORT=7860
